APP_ENV=development
HTTP_ADDR=:8080
# Buat user fite_app di MySQL Workbench (lihat README). Jangan memakai root.
DB_DSN=fite_app:rahasia@tcp(127.0.0.1:3306)/fite_arsip?charset=utf8mb4&parseTime=true&loc=UTC&time_zone=%27%2B00%3A00%27
JWT_SECRET=ganti-dengan-minimal-32-byte-acak-yang-panjang
JWT_ISSUER=fite-arsip-api
JWT_AUDIENCE=fite-arsip-web
ACCESS_TTL=15m
REFRESH_TTL=168h
SESSION_MAX_AGE=720h
ALLOWED_ORIGIN=http://localhost:3000
COOKIE_DOMAIN=
COOKIE_SECURE=false
TRUSTED_PROXIES=
# Diwajibkan mulai fase 5 (penyimpanan GCS)
GCS_BUCKET=
GCS_CREDENTIALS_FILE=
RETENTION_YEARS=8
RETENTION_GRACE_DAYS=90
TIMEZONE=Asia/Jakarta
